{
 "name":"mezhdu-strok-reader",
 "main":"worker/index.mjs",
 "compatibility_date":"2026-06-01",
 "workers_dev":true,
 "assets":{"directory":"dist","binding":"ASSETS","run_worker_first":["/api/*","/telegram/*"]},
 "durable_objects":{"bindings":[{"name":"READERS","class_name":"ReaderProfile"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["ReaderProfile"]}]
}
